# 统一换行符
# 默认 LF：避免在 Windows 上 checkout 出 CRLF 后 shebang 失效
* text=auto eol=lf

*.sh    text eol=lf
*.js    text eol=lf
*.json  text eol=lf
*.md    text eol=lf

# 批处理必须 CRLF —— cmd.exe 解析 LF-only 的 .bat 时 goto 标签会失效
*.bat   text eol=crlf
*.cmd   text eol=crlf

# 二进制
*.pdf   binary
*.png   binary
*.jpg   binary
*.xlsx  binary
